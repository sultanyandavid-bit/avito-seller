# Default demo makes no external provider calls. Existing assistant integrations remain reserved.
# Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# AI seller: paid requests remain OFF unless explicitly authorized by the owner.
SELLER_AI_ENABLE_REAL=false
# A separate random administrator access code (>=32 characters), never an API key.
SELLER_AI_ACCESS_TOKEN=
# JSON array of {provider,id,label}; ids must be verified in the provider account/docs.
# Optional tariff: {inputPerMillion,outputPerMillion,currency,source} from verified pricing.
SELLER_AI_MODELS=[]
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# Workspace-specific HTTPS base URL ending in /compatible-mode/v1, from your region's docs.
QWEN_BASE_URL=
# Short-lived OAuth access token, NOT the permanent Basic authorization key.
GIGACHAT_ACCESS_TOKEN=
